{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gnimsys.ai/schemas/fusion-ai-chat/config-v1.schema.json",
  "title": "xxx-gnimsys-ai-chat config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "agent", "auth", "protocol"],
  "properties": {
    "mode": {
      "$comment": "Spec §2: chat | app | gnimsys. Only the implemented modes are accepted: app and gnimsys are refused until they are built.",
      "enum": ["chat"]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowCode"],
      "properties": {
        "workflowCode": { "type": "string", "minLength": 1 },
        "version": {
          "$comment": "PUBLISHED runs the published workflow (/chat); DRAFT runs the draft through Studio's test path (/debug, invocationMode ADMIN).",
          "enum": ["PUBLISHED", "DRAFT"],
          "default": "PUBLISHED"
        },
        "triggerType": { "const": "chat" },
        "additionalContext": { "type": "object" },
        "responseLanguage": { "type": "string" }
      }
    },
    "app": {
      "$comment": "The Agentic App of mode app (spec §8, not built yet): carried so a mode switch can offer it once it is built.",
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationCode", "applicationType"],
      "properties": {
        "applicationCode": { "type": "string", "minLength": 1 },
        "applicationType": { "enum": ["PUBLISHED", "DRAFT"] },
        "panel": { "type": "string" },
        "appContext": { "type": "string" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "fusionShell" } }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkVersion"],
      "properties": {
        "checkVersion": { "type": "string", "minLength": 1 },
        "hcmRestBase": { "type": "string", "pattern": "^/hcmRestApi/" }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "greeting": { "type": "string" },
        "placeholder": { "type": "string" },
        "starterQuestions": {
          "default": "fromWorkflow",
          "oneOf": [
            { "const": "fromWorkflow" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "conversations": { "type": "boolean", "default": true },
        "viewer": { "type": "boolean", "default": false },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roles"],
          "properties": {
            "roles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "modeSwitch": {
          "$comment": "Debug hosts: the header's mode switch, listing the modes that are implemented and configured; a switch is a full reset.",
          "type": "boolean",
          "default": false
        },
        "debug": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rawFrames": {
              "$comment": "Debug hosts: every reply's raw SSE data payloads in a collapsible panel under it.",
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "maxFiles": { "type": "number", "exclusiveMinimum": 0, "default": 5 },
        "maxSizeMB": { "type": "number", "exclusiveMinimum": 0, "default": 50 },
        "accept": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["pdf", "docx", "xlsx", "pptx", "csv", "txt", "md", "html", "json", "xml", "zip", "image/*"]
        }
      }
    },
    "datasources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowInline": { "type": "boolean", "default": false },
        "allowPrefixes": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "widgets": { "type": "object" },
    "submit": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "envelope": { "const": "gnimsysSubmit", "default": "gnimsysSubmit" } }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "kind": { "const": "oracle", "default": "oracle" } }
    }
  },
  "if": {
    "required": ["files"],
    "properties": { "files": { "required": ["enabled"], "properties": { "enabled": { "const": true } } } }
  },
  "then": {
    "properties": { "protocol": { "required": ["hcmRestBase"] } }
  }
}
