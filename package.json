{
  "name": "fusion-ai-chat",
  "version": "1.0.0",
  "description": "Chat component for Oracle AI Agent Studio agents (VB App UI extensions): JET pack xxx-gnimsys-ai, tag <xxx-gnimsys-ai-chat>",
  "dependencies": {
    "@oracle/oraclejet": "~19.0.10",
    "@oracle/oraclejet-core-pack": "~19.0.10"
  },
  "devDependencies": {
    "@oracle/ojet-cli": "~19.0.6",
    "@oracle/oraclejet-jest-preset": "~19.0.10",
    "@playwright/test": "1.56.0",
    "@testing-library/preact": "^3.2.3",
    "@types/jest": "^29.5.3",
    "extract-zip": "^1.7.0",
    "fs-extra": "^8.1.0",
    "glob": "10.4.5",
    "http-proxy-middleware": "^3.0.7",
    "jest": "^29.6.2",
    "jest-environment-jsdom": "^29.6.2",
    "typescript": "5.8.3",
    "underscore": "^1.10.2",
    "yargs-parser": "13.1.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "private": true,
  "scripts": {
    "build": "ojet build",
    "build:release": "ojet build --release",
    "serve": "ojet serve --server-only --server-port=8000 --livereload=false",
    "test": "jest -c test-config/jest.config.cjs",
    "package": "ojet package pack xxx-gnimsys-ai",
    "e2e": "playwright test"
  },
  "overrides": {
    "@types/minimatch": "5.1.2"
  }
}
